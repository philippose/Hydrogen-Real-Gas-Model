FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      extrudeMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //



constructFrom   patch;
sourceCase      "<case>";

sourcePatches   (front);
exposedPatchName back;

extrudeModel    wedge;

sectorCoeffs
{
    axisPt          (0 0 0);
    axis            (0 0 1);
    angle           5;
}

flipNormals     false;

mergeFaces      false;




