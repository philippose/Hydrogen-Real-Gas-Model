// * * * * * * * * * * * MESH GENERATION TOOL OF 2D NOZZLE * * * * * * * * * // 
//									     //
// * * * * * * * * * * * * * * * INPUT PARAMETERS  * * * * * * * * * * * * * //
//									     //
// - - - - - - - - - - - - - - - - - Geometry - - - - - -  - - - - - - - - - //
//									     //
sc 0.001; 	// Scaling factor (sc = 0.001 ==> d = 1 mm)	     	     //
li 0.5; 	// Inlet length					     	     //
// list of z and y coordinates of nozzle contour  			     //
#include "Meas_Cyl.out";  						     //
//									     //
// - - - - - - - - - - - - - - - - - - Mesh - - - - - - - - - - - - - - - -  //
//									     //
cy 90;		// Number of cells in y of nozzle	     	     	     //
cz 600;		// Number of cells in z of nozzle	     	     	     //
gy 10;		// Grading in y towards nozzle wall	     	     	     //
//									     //
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// * * * * * * * * * !!! DO NOT CHANGE THE FOLLOWING CODE !!!  * * * * * * * //
// Calculated parameter list
#codeStream
{
	codeInclude 
	#{ 	#include "scalarField.H"
	#};
	code 
	#{
		scalar li = scalar(dict.lookupOrDefault("li",0.0));
		scalar cz = scalar(dict.lookupOrDefault("cz",0.0));
    		scalarField BSz = scalarField(dict.lookup("BSz"));
		scalarField BSy = scalarField(dict.lookup("BSy"));
		scalar BSd = scalar(dict.lookupOrDefault("BSd",0));
		
		scalar BSn = BSz.size();	
		scalar ze = BSz[BSn-1] - BSz[0];
		scalar zm1 = BSz[1] - BSz[0];
		scalar zm2 = BSz[ceil(BSd/2) + 1] - BSz[0];
		scalar zm4 = BSz[ceil((BSd+BSn-1)/2) + 1] - BSz[0];
		scalar zb2 = BSz[ceil(BSd/2)] - BSz[0];
		scalar zb3 = BSz[BSd] - BSz[0];
		scalar zb4 = BSz[ceil((BSd+BSn-1)/2)] - BSz[0];

		scalar ys = BSy[0];
		scalar ye = BSy[BSn-1];
		scalar ym1 = BSy[1];
		scalar ym2 = BSy[ceil(BSd/2) + 1];
		scalar ym4 = BSy[ceil((BSd+BSn-1)/2) + 1];
		scalar yb2 = BSy[ceil(BSd/2)];
		scalar yb3 = BSy[BSd];
		scalar yb4 = BSy[ceil((BSd+BSn-1)/2)];
		
		scalar zh1 = zm1*(ys/(ys-ym1));
		scalar zh2 = -1.0*yb2*((zm2-zb2)/(ym2-yb2));
		scalar zh4 = yb4*((zm4-zb4)/(ym4-yb4));
		scalar z1 = -1.0*(sqrt(ys*ys + zh1*zh1) - zh1); 
		scalar z2 = zb2 - ((sqrt(yb2*yb2 + zh2*zh2) - zh2));
		scalar z4 = zb4 + ((sqrt(yb4*yb4 + zh4*zh4) - zh4));
		scalar y11 = ys + li;
		scalar z0 = -1.0*(ys + li);
		scalar cz0 = ceil(cz*((z1 - z0)/(ze - z1)));
		scalar cz1 = ceil(cz*((z2 - z1)/(ze - z1)));
		scalar cz2 = ceil(cz*((zb3 - z2)/(ze - z1)));
		scalar cz3 = ceil(cz*((z4 - zb3)/(ze - z1)));
		scalar cz4 = ceil(cz*((ze - z4)/(ze - z1)));
		
		os << "ze " << ze << ";" << nl ;
		os << "zb2 " << zb2 << ";" << nl ;
		os << "zb3 " << zb3 << ";" << nl ;
		os << "zb4 " << zb4 << ";" << nl ;
		os << "ys " << ys << ";" << nl ;
		os << "ye " << ye << ";" << nl ;
		os << "yb2 " << yb2 << ";" << nl ;
		os << "yb3 " << yb3 << ";" << nl ;
		os << "yb4 " << yb4 << ";" << nl ;
		os << "z1 " << z1 << ";" << nl ;
		os << "z2 " << z2 << ";" << nl ;
		os << "z4 " << z4 << ";" << nl ;

		os << "y11 " << y11 << ";" << nl ;
		os << "z0 " << z0 << ";" << nl ;
		os << "cz0 " << cz0 << ";" << nl ;
		os << "cz1 " << cz1 << ";" << nl ;
		os << "cz2 " << cz2 << ";" << nl ;
		os << "cz3 " << cz3 << ";" << nl ;
		os << "cz4 " << cz4 << ";" << nl ;
	#};
};

